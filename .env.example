# GpuViewR environment variables

# JWT secret. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-please-generate-with-openssl

# HTTP server port (backend listens here in dev and inside the container in prod)
PORT=3015

# Vite dev client port (npm run dev only)
VITE_PORT=5181

# Optional: LAN IP shown in the boot banner. If unset, auto-detected.
# HOST_IP=192.168.1.42

# Optional public URL (for share links / reverse proxy)
# PUBLIC_URL=https://gpu.example.com

# Timezone
TZ=Europe/Paris

# GPU collector tick (ms). How often the chosen smi binary is sampled.
GPU_TICK_MS=1000

# Vendor pinning for the local-host collector.
#   auto    — probe nvidia-smi first, fall back to rocm-smi (default)
#   nvidia  — force nvidia-smi
#   amd     — force rocm-smi (requires /opt/rocm + libdrm-amdgpu1, see Docs/AMD.md)
GPU_VENDOR=auto

# Path to the rocm-smi binary. Override if your ROCm install is not
# in /opt/rocm (e.g. /opt/rocm-6.0/bin/rocm-smi).
# ROCM_SMI_PATH=/opt/rocm/bin/rocm-smi

# History retention (days)
RETENTION_DAYS=7

# Docker only. Host port that maps to the container's PORT
DASHBOARD_PORT=7510
