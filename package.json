{
  "name": "gpuviewr",
  "private": true,
  "version": "0.8.11",
  "type": "module",
  "description": "Modern real-time NVIDIA GPU monitoring dashboard (React + Vite + Express + WebSocket + uPlot)",
  "homepage": "https://github.com/Erreur32/GpuViewR",
  "repository": {
    "type": "git",
    "url": "https://github.com/Erreur32/GpuViewR.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "lsof -ti:3015 2>/dev/null | xargs -r kill -9; lsof -ti:5181 2>/dev/null | xargs -r kill -9; true",
    "dev": "concurrently --kill-others -n server,client -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:mock": "cross-env MOCK_GPU=1 npm run dev",
    "predev:demo": "lsof -ti:5181 2>/dev/null | xargs -r kill -9; true",
    "dev:demo": "cross-env VITE_DEMO=1 vite",
    "build:agent": "npm install --prefix agent --no-audit --no-fund && npm run build --prefix agent",
    "dev:client": "vite",
    "dev:server": "cross-env NODE_ENV=development tsx watch --include=.env --include=server/**/*.ts server/index.ts",
    "build": "vite build",
    "build:demo": "cross-env VITE_DEMO=1 VITE_BASE_PATH=/GpuViewR/ vite build",
    "build:demo:root": "cross-env VITE_DEMO=1 VITE_BASE_PATH=/ vite build",
    "preview:demo": "vite preview --outDir dist-demo --base=/GpuViewR/",
    "preview:demo:root": "vite preview --outDir dist-demo --base=/",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "version:bump": "./scripts/update-version.sh",
    "version:tag-push": "./scripts/update-version.sh",
    "test": "tsx --test server/**/*.test.ts",
    "user:reset-password": "tsx scripts/reset-password.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "i18next": "^25.8.4",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.577.0",
    "mqtt": "^5.15.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.18.2",
    "tsx": "^4.23.1",
    "uplot": "^1.6.32",
    "ws": "^8.21.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
