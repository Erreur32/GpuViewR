{
  "name": "gpuviewr-agent",
  "version": "0.8.11",
  "private": true,
  "description": "Remote GpuViewR agent — collects nvidia-smi locally and pushes to a central hub via WebSocket",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "start:bundle": "node dist/agent.mjs",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "tsx": "^4.22.0",
    "typescript": "^5.6.3"
  }
}
