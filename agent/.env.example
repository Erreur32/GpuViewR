# =====================================================
# GpuViewR Agent — environment variables
# =====================================================
# Drop this file next to docker-compose.agent.yml (NVIDIA) or
# docker-compose.agent.amd.yml (AMD/ROCm) and rename to `.env`.
# Compose will substitute ${VAR} references automatically.
#
# For bare-metal / systemd installs the canonical location is
# /etc/gpuviewr-agent.env (mode 0600) — same keys, no compose
# substitution. The install.sh script writes that file for you.

# -- Required (one-shot values handed out by the hub UI) --------
# Go to Settings → Hosts → + Add host on the hub; the modal shows
# these three exactly once. Re-generate by removing the host and
# adding again.

HUB_URL=ws://192.168.1.10:7510/agent
HOST_ID=00000000-0000-0000-0000-000000000000
AGENT_TOKEN=replace-me-with-the-token-from-the-hub-ui

# wss:// is required when the hub sits behind a TLS reverse proxy
# in production. ws:// only against loopback / RFC1918 hosts.

# -- GPU vendor ------------------------------------------------
# 'auto'   : probe nvidia-smi first, fall back to rocm-smi
# 'nvidia' : force nvidia-smi (default historical behavior)
# 'amd'    : force rocm-smi (set this in docker-compose.agent.amd.yml)
GPU_VENDOR=auto

# Path to the smi binary inside the container. Defaults match what
# the NVIDIA Container Toolkit (nvidia) / the standard /opt/rocm
# bind-mount (amd) expose. The AMD path points at the Python script,
# which is why the agent image now ships python3-minimal.
# NVIDIA_SMI_PATH=nvidia-smi
# ROCM_SMI_PATH=/opt/rocm/bin/rocm-smi

# AMD-only: numeric GIDs of the host's `video` and `render` groups.
# Defaults match Debian/Ubuntu out of the box; ROCm-installed hosts
# often shift `render` to 992. Find yours with:
#   getent group video render
# VIDEO_GID=44
# RENDER_GID=109

# -- Sampling cadence + telemetry scope -------------------------
TICK_MS=1000
FEATURES=gpu,system,temps,processes
LOG_LEVEL=info

# -- Networking / reconnect -------------------------------------
# Exponential backoff caps here; ±20% jitter is added internally.
RECONNECT_MAX_MS=30000

# 1 only against a hub with a self-signed cert in development.
# Never in production — defeats the point of wss://.
TLS_INSECURE=0

# -- Optional metadata + dev knobs ------------------------------
# Friendly label shown next to this host in the hub UI.
# AGENT_LABEL=jarvis-amd

# Where the hub-tracked /proc lives inside the container. The
# compose files bind-mount the host's /proc here so PIDs resolve
# without sharing the host PID namespace.
HOST_PROC=/host/proc

# Persist the outbound ring buffer to disk so samples queued during
# a hub outage survive an agent restart. Stub in jalon 4 — wire it
# in v0.3.1; safe to leave at 0 today.
AGENT_BUFFER_PERSIST=0

# Synthetic samples instead of spawning a real smi binary. Dev only.
# MOCK_GPU=0
